@page "/proxysql/global-variables"

@using ProxysqlAdminUi.Web.Extensions
@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H3">Global Variables</RadzenText>

    <RadzenText TextStyle="TextStyle.Caption">
        Only @("mysql-") and @("admin-") variables can be applied from here; every other family is read-only.
    </RadzenText>

    <RadzenDataGrid @ref="_variablesGrid" Data="@_variables" TItem="GlobalVariableModel"
                    AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="20"
                    EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow">
        <Columns>
            <RadzenDataGridColumn TItem="GlobalVariableModel" Property="@nameof(GlobalVariableModel.VariableName)"
                                  Title="Variable Name" Width="300px">
                <FooterTemplate>
                    Total Variables: @(_variables?.Count() ?? 0)
                </FooterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="GlobalVariableModel" Property="@nameof(GlobalVariableModel.VariableValue)"
                                  Title="Value" Width="300px">
                <EditTemplate Context="variable">
                    <RadzenTextBox @bind-Value="variable.VariableValue" Style="width:100%" Name="Value" />
                    <RadzenRequiredValidator Text="Value is required" Component="Value" Popup="true" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="GlobalVariableModel" Context="variable"
                                  Width="70px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                <Template Context="variable">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium"
                                  Disabled="@(_saving || !GlobalVariableFamily.IsEditable(variable.VariableName))"
                                  title="@ReadOnlyReason(variable)"
                                  Click="@(args => EditRow(variable))" />
                </Template>
                <EditTemplate Context="variable">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" Disabled="@_saving" Click="@((args) => SaveRow(variable))">
                    </RadzenButton>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Disabled="@_saving" Click="@((args) => CancelEdit(variable))">
                    </RadzenButton>
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private IEnumerable<GlobalVariableModel> _variables = [];
    private RadzenDataGrid<GlobalVariableModel>? _variablesGrid;
    private readonly Dictionary<string, string> _originalValues = new();

    /// <summary>
    /// Set while an update is in flight so the save tick cannot be submitted twice against the
    /// same scoped DbContext.
    /// </summary>
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _variables = await ProxySqlRepository.GetGlobalVariables();
    }

    private string ReadOnlyReason(GlobalVariableModel variable) =>
        GlobalVariableFamily.IsEditable(variable.VariableName)
            ? "Edit"
            : GlobalVariableFamily.NotEditableMessage(variable.VariableName);

    private async Task EditRow(GlobalVariableModel variable)
    {
        if (_variablesGrid is null || !GlobalVariableFamily.IsEditable(variable.VariableName))
        {
            return;
        }

        _originalValues[variable.VariableName] = variable.VariableValue;
        await _variablesGrid.EditRow(variable);
    }

    /// <summary>
    /// Runs inside the grid's RowUpdate, so the awaited repository call completes before the
    /// component moves on: no fire-and-forget task can touch the scoped DbContext after disposal.
    /// </summary>
    private async Task OnUpdateRow(GlobalVariableModel variable)
    {
        try
        {
            await ProxySqlRepository.UpdateGlobalVariable(variable);
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Variable updated");
            _originalValues.Remove(variable.VariableName);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
            RevertRow(variable);
        }
    }

    private async Task SaveRow(GlobalVariableModel variable)
    {
        if (_saving || _variablesGrid is null)
        {
            return;
        }

        if (!GlobalVariableFamily.IsEditable(variable.VariableName))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Read-only variable",
                GlobalVariableFamily.NotEditableMessage(variable.VariableName));
            RevertRow(variable);
            _variablesGrid.CancelEditRow(variable);
            return;
        }

        _saving = true;
        try
        {
            await _variablesGrid.UpdateRow(variable);
        }
        finally
        {
            _saving = false;
        }
    }

    private void CancelEdit(GlobalVariableModel variable)
    {
        RevertRow(variable);
        _variablesGrid?.CancelEditRow(variable);
    }

    /// <summary>
    /// Puts the last known good value back on the model. Safe to call when the row has already
    /// left edit mode, which is what happens after a failed update.
    /// </summary>
    private void RevertRow(GlobalVariableModel variable)
    {
        if (_originalValues.Remove(variable.VariableName, out var original))
        {
            variable.VariableValue = original;
        }
    }
}
