@page "/proxysql/actions"

@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject NotificationService NotificationService
@inject DialogService DialogService


<RadzenText Text="Actions" TextStyle="TextStyle.H3" />

<RadzenRow>
    <RadzenColumn Size="2">
        <RadzenButton Text="Reset Statistics" Click="@Reload" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Disabled="@_resetting" />
    </RadzenColumn>
    <RadzenColumn Size="2">
        <RadzenButton Text="Flush Query Cache" Click="@FlushCache" Icon="clear_all" ButtonStyle="ButtonStyle.Light"
                      Disabled="@_flushing" />
    </RadzenColumn>
</RadzenRow>



@code {

    /// <summary>Set while the corresponding action is in flight so its button stays disabled.</summary>
    private bool _resetting;

    private bool _flushing;

    private async Task Reload()
    {
        if (_resetting)
        {
            return;
        }

        var confirmed = await DialogService.Confirm(
            "This clears stats_mysql_query_digest and the per-rule hit counters for good, then reloads " +
            "the query rules into the runtime. Historical query statistics cannot be recovered.",
            "Reset statistics?",
            new ConfirmOptions { OkButtonText = "Reset statistics", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        _resetting = true;
        try
        {
            await ProxySqlRepository.ResetStats();
            NotificationService.Notify(NotificationSeverity.Success, "Statistics reset", "ProxySQL statistics have been reset");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Reset failed",
                "Resetting statistics failed: " + ex.Message +
                " The statistics may already have been cleared while the query rules were not reloaded into the runtime - " +
                "re-run the action or reload the rules from the Rules page.");
        }
        finally
        {
            _resetting = false;
        }
    }

    private async Task FlushCache()
    {
        if (_flushing)
        {
            return;
        }

        var confirmed = await DialogService.Confirm(
            "This empties the ProxySQL query cache. Every cached result is discarded and the next " +
            "execution of each query goes to a backend server until the cache refills.",
            "Flush query cache?",
            new ConfirmOptions { OkButtonText = "Flush cache", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        _flushing = true;
        try
        {
            await ProxySqlRepository.FlushQueryCache();
            NotificationService.Notify(NotificationSeverity.Success, "Cache Flushed", "Query cache has been flushed");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Flush failed",
                "Flushing the query cache failed: " + ex.Message);
        }
        finally
        {
            _flushing = false;
        }
    }
}
