@namespace ProxysqlAdminUi.Web.Components.CustomComponents

<RadzenStack Gap="0.5rem">
    <RadzenRow>
        <RadzenColumn Size="3">
            <RadzenLabel Text="Hours" />
            <RadzenNumeric Min="0" @bind-Value="Hours" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenLabel Text="Minutes" />
            <RadzenNumeric Min="0" Max="59" @bind-Value="Minutes" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenLabel Text="Seconds" />
            <RadzenNumeric Min="0" Max="59" @bind-Value="Seconds" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenLabel Text="Milliseconds" />
            <RadzenNumeric Min="0" Max="999" @bind-Value="Milliseconds" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton ButtonType="ButtonType.Button"
                      ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small"
                      Icon="backspace"
                      Text="Clear"
                      Disabled="@(Value is null)"
                      Click="@ClearAsync" />
    </RadzenStack>
</RadzenStack>

@code {
    /// <summary>
    /// The duration in milliseconds, or <c>null</c> when no duration is set. All four boxes at
    /// zero means "not set" and emits <c>null</c>, never <c>0</c>.
    /// </summary>
    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    private int Hours
    {
        get => TimeInputConverter.Decompose(Value).Hours;
        set => UpdateValue(value, Minutes, Seconds, Milliseconds);
    }

    private int Minutes
    {
        get => TimeInputConverter.Decompose(Value).Minutes;
        set => UpdateValue(Hours, value, Seconds, Milliseconds);
    }

    private int Seconds
    {
        get => TimeInputConverter.Decompose(Value).Seconds;
        set => UpdateValue(Hours, Minutes, value, Milliseconds);
    }

    private int Milliseconds
    {
        get => TimeInputConverter.Decompose(Value).Milliseconds;
        set => UpdateValue(Hours, Minutes, Seconds, value);
    }

    private async Task ClearAsync()
    {
        Value = null;
        await ValueChanged.InvokeAsync(Value);
    }

    // Property setters cannot await; EventCallback.InvokeAsync completes synchronously for the
    // common (non-async handler) case and the renderer surfaces any failure of the returned task.
    private void UpdateValue(int hours, int minutes, int seconds, int milliseconds)
    {
        Value = TimeInputConverter.ToMilliseconds(hours, minutes, seconds, milliseconds);
        _ = ValueChanged.InvokeAsync(Value);
    }
}
