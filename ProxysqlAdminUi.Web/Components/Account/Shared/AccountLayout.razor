@inherits LayoutComponentBase

@inject NavigationManager NavigationManager

@* Every statically rendered /Account page (login, logout, lockout, manage/*) is built with
   Bootstrap classes; link the stylesheet once here rather than per page. The interactive app
   uses Radzen only and does not load it. *@
<HeadContent>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</HeadContent>

@if (HttpContext is null)
{
    <p>Loading...</p>
}
else
{
    <div class="container">
        @Body
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            // If this code runs, we're currently rendering in interactive mode, so there is no HttpContext.
            // The identity pages need to set cookies, so they require an HttpContext. To achieve this we
            // must transition back from interactive mode to a server-rendered page.
            NavigationManager.Refresh(forceReload: true);
        }
    }
}
